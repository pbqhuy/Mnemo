<Window x:Class="Mnemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mnemo.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Mnemo - Flashcard &amp; Spaced Repetition" 
        Height="620" Width="880"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <!-- LAYOUT CHÍNH CỦA BỘ KHUNG -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Sub Header / Actions -->
                <RowDefinition Height="*"/>    <!-- Deck List Area -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. TOP BAR -->
            <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mnemo" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Spaced Repetition System" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Reload Action -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="🔄 Làm mới" Command="{Binding LoadDecksCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. SUB HEADER -->
            <Border Grid.Row="1" Background="#162032" Padding="24,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bộ thẻ ghi nhớ" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Khung ứng dụng WPF Clean Architecture kết nối SQLite" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="+ Tạo bộ thẻ mới" Command="{Binding OpenCreateDeckDialogCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- 3. DECK LIST / CONTENT AREA -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="⏳ Đang nạp dữ liệu..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Decks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📭" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Chưa có bộ thẻ nào trong cơ sở dữ liệu." FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bấm '+ Tạo bộ thẻ mới' để thêm bộ thẻ đầu tiên!" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                        <Button Content="+ Tạo bộ thẻ" Command="{Binding OpenCreateDeckDialogCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Table Header & Items -->
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="TÊN BỘ THẺ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="MỚI" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="ĐANG HỌC" FontWeight="Bold" FontSize="11" Foreground="#FB923C" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="CẦN ÔN" FontWeight="Bold" FontSize="11" Foreground="#4ADE80" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="THAO TÁC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding Decks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeckItemViewModel}">
                                    <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Badges -->
                                            <Border Grid.Column="1" Background="{StaticResource BadgeNewBgBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NewCount}" Foreground="{StaticResource BadgeNewTextBrush}" FontWeight="Bold" FontSize="11"/>
                                            </Border>

                                            <Border Grid.Column="2" Background="{StaticResource BadgeLearnBgBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LearningCount}" Foreground="{StaticResource BadgeLearnTextBrush}" FontWeight="Bold" FontSize="11"/>
                                            </Border>

                                            <Border Grid.Column="3" Background="{StaticResource BadgeDueBgBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DueCount}" Foreground="{StaticResource BadgeDueTextBrush}" FontWeight="Bold" FontSize="11"/>
                                            </Border>

                                            <!-- Action -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Xóa" 
                                                        Command="{Binding DataContext.DeleteDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SubtleButtonStyle}" 
                                                        Padding="8,4" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 4. BOTTOM STATUS BAR -->
            <Border Grid.Row="3" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="#064E3B" CornerRadius="10" Padding="8,3">
                            <TextBlock Text="🟢 SQLite: mnemo.db" FontSize="11" Foreground="#86EFAC" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY: TẠO BỘ THẺ MỚI -->
        <Grid Background="#B0000000" Visibility="{Binding IsCreateDeckDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Width="400" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Tạo bộ thẻ mới" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="Tên bộ thẻ:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewDeckName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Command="{Binding CloseCreateDeckDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Width="75"/>
                        <Button Content="Lưu" Command="{Binding SaveNewDeckCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="75"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
